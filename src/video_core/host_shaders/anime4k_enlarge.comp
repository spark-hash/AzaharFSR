// Full-frame compute port of Anime4K Classic's separable Sobel luminance passes.
#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D source;
layout(push_constant) uniform Parameters { vec4 crop; vec2 output_size; float strength; } params;
layout(binding=1, rgba16f) writeonly uniform image2D destination;
vec3 samplePixel(ivec2 p) {
    vec2 uv=(vec2(clamp(p,ivec2(0),ivec2(params.output_size)-1))+0.5)/params.output_size;
    vec2 halfPixel=0.5/vec2(textureSize(source,0));
    vec2 middle=(params.crop.xy+params.crop.zw)*0.5;
    vec2 pos=clamp(mix(params.crop.xy,params.crop.zw,uv),
                   min(params.crop.xy+halfPixel,middle),max(params.crop.zw-halfPixel,middle));
    return textureLod(source,pos,0).rgb;
}
float lum(ivec2 p) { return dot(samplePixel(p),vec3(0.2627,0.6780,0.0593)); }
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p,ivec2(params.output_size)))) return;
    float tl=lum(p+ivec2(-1,-1)),t=lum(p+ivec2(0,-1)),tr=lum(p+ivec2(1,-1));
    float l=lum(p+ivec2(-1,0)),r=lum(p+ivec2(1,0));
    float bl=lum(p+ivec2(-1,1)),b=lum(p+ivec2(0,1)),br=lum(p+ivec2(1,1));
    vec2 grad=vec2(tr+2.0*r+br-tl-2.0*l-bl,bl+2.0*b+br-tl-2.0*t-tr);
    // Signed gradient must not be clamped into RGBA8: retain it in RGBA16F alpha.
    imageStore(destination,p,vec4(samplePixel(p),1.0-length(grad)));
}
